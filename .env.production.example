# Railway Bid Intelligence production environment template
# Copy values into the approved enterprise secret/configuration manager.
# Do not commit real credentials or tokens.

ENVIRONMENT=production
SECRET_KEY=<generate-at-least-32-random-characters>

DATABASE_URL=postgresql+psycopg://<db-user>:<strong-password>@<postgres-host>:5432/<database>
POSTGRES_DB=railway_bid
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<strong-password>

STORAGE_ROOT=/data/documents
MAX_FILE_SIZE_MB=50
MAX_BATCH_SIZE_MB=250
MAX_FILES_PER_BATCH=100

CORS_ORIGINS=https://<approved-frontend-host>

AUTH_MODE=oidc
OIDC_ISSUER=https://<enterprise-idp-issuer>/
OIDC_AUDIENCE=<registered-api-audience>
OIDC_JWKS_URL=https://<enterprise-idp-jwks-endpoint>
OIDC_EMAIL_CLAIM=email

NEXT_PUBLIC_API_URL=https://<approved-api-host>/api/v1
NEXT_PUBLIC_AUTH_MODE=oidc
NEXT_PUBLIC_OIDC_AUTHORITY=https://<enterprise-idp-authority>
NEXT_PUBLIC_OIDC_CLIENT_ID=<registered-spa-client-id>
NEXT_PUBLIC_OIDC_REDIRECT_URI=https://<approved-frontend-host>/auth/callback
NEXT_PUBLIC_OIDC_SCOPE=openid profile email
